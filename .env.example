# Application Configuration
APP_NAME=Server Monitor Backend
APP_VERSION=0.1.0
DEBUG=False

# Database Configuration (Production ready)
DATABASE_URL=postgresql+asyncpg://postgres:postgres@postgres:5432/server_monitor
DB_USER=postgres
DB_PASSWORD=your_secure_db_password
DB_NAME=server_monitor

# Security
SECRET_KEY=your-super-secret-and-long-random-string-change-this-immediately
ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_MINUTES=1440
JWT_REFRESH_EXPIRE_DAYS=7

# Encryption at rest (Fernet). Generate with:
#   python -c "from cryptography.fernet import Fernet; print(Fernet.generate_key().decode())"
SSH_ENCRYPTION_KEY=replace-with-generated-fernet-key

# SSH Connection
SSH_TIMEOUT=30
SSH_CONNECTION_RETRIES=3

# Metrics Collection
METRICS_COLLECTION_INTERVAL=60
METRICS_INTERVAL_SEC=15
METRICS_RETENTION_DAYS=30

# ML / Anomaly Detection (rule-based stubs until real models land)
ML_INTERVAL_MIN=5

# Audit
AUDIT_LOG_RETENTION_DAYS=180

# Redis
REDIS_URL=redis://redis:6379/0

# Notifications — Telegram
TELEGRAM_BOT_TOKEN=
TELEGRAM_DEFAULT_CHAT_ID=

# Logging
LOG_LEVEL=INFO

# Application Settings
ALLOWED_HOSTS=*
MAX_WORKERS=2
TIMEOUT_GRACEFUL_SHUTDOWN=30

# Frontend Integration
FRONTEND_URL=http://localhost:5173
BACKEND_CORS_ORIGINS=http://localhost,http://localhost:8000,http://localhost:5173

# Web Console
WEBSOCKET_MAX_SIZE=1048576
WEBSOCKET_PING_INTERVAL=20

# ML / Ollama
ML_MODELS_DIR=models
ML_INFERENCE_INTERVAL_SEC=60
OLLAMA_BASE_URL=http://ollama:11434
OLLAMA_MODEL=qwen2.5:3b
OLLAMA_TIMEOUT_SEC=10
